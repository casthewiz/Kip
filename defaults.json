{
  "hosts": {
    "kip": {"skills": "~/.kip/skills"},
    "claude-code": {
      "requires": {"file": ["~/.claude"]},
      "skills": "~/.claude/skills",
      "project_skills": ".claude/skills",
      "rules": {"append": "~/.claude/CLAUDE.md", "line": "@{rules}"},
      "hooks": {
        "settings": "~/.claude/settings.json",
        "project_settings": ".claude/settings.json",
        "events": {
          "SessionStart": [{"hooks": [{"type": "command", "command": "python3 {receipt} check --hook start"}]}],
          "Stop": [{"hooks": [{"type": "command", "command": "python3 {receipt} check --hook stop"}]}],
          "SubagentStop": [{"hooks": [{"type": "command", "command": "python3 {receipt} check --hook subagent"}]}],
          "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 {receipt} check --hook pr"}]},
                         {"matcher": "mcp__.*(create_pull_request|create_pr)", "hooks": [{"type": "command", "command": "python3 {receipt} check --hook pr"}]},
                         {"matcher": "Edit|MultiEdit|Write|NotebookEdit", "hooks": [{"type": "command", "command": "python3 {receipt} check --hook edit"}]},
                         {"matcher": "*", "hooks": [{"type": "command", "command": "python3 {receipt} check --hook tool"}]}],
          "PermissionRequest": [{"hooks": [{"type": "command", "command": "python3 {receipt} check --hook ask"}]}],
          "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 {receipt} check --hook prompt"}]}],
          "SessionEnd": [{"hooks": [{"type": "command", "command": "python3 {receipt} check --hook end"}]}]
        }
      }
    },
    "cursor": {
      "requires": {"file": ["~/.cursor"]},
      "skills": "~/.cursor/skills",
      "project_skills": ".cursor/skills",
      "rules": {
        "sqlite": ["~/Library/Application Support/Cursor/User/globalStorage/state.vscdb",
                   "~/.config/Cursor/User/globalStorage/state.vscdb",
                   "$APPDATA/Cursor/User/globalStorage/state.vscdb"],
        "key": "aicontext.personalContext",
        "manual": "Paste {rules} into Cursor Settings → Rules → User Rules (re-paste after pulling)."
      },
      "logs": ["~/Library/Application Support/Cursor/logs", "~/.config/Cursor/logs", "$APPDATA/Cursor/logs"],
      "hooks": {
        "settings": "~/.cursor/hooks.json",
        "project_settings": ".cursor/hooks.json",
        "init": {"version": 1},
        "events": {
          "sessionStart": [{"command": "python3 {receipt} check --hook start"}],
          "stop": [{"command": "python3 {receipt} check --hook stop"}],
          "beforeShellExecution": [{"command": "python3 {receipt} check --hook pr"}],
          "beforeMCPExecution": [{"command": "python3 {receipt} check --hook pr"}],
          "afterFileEdit": [{"command": "python3 {receipt} check --hook tool"}],
          "preToolUse": [{"command": "python3 {receipt} check --hook tool"}],
          "beforeSubmitPrompt": [{"command": "python3 {receipt} check --hook prompt"}],
          "afterAgentResponse": [{"command": "python3 {receipt} check --hook response"}]
        }
      }
    }
  },
  "connectors": {
    "browser": {"kind": "tool", "about": "The agent's own browser pane or browser extension"}
  },
  "evidence": {
    "frontend": {
      "doc": "skills/verification/kip-receipts/providers/frontend.md",
      "requires": {"file": ["~/.kip/node_modules/@playwright/test/cli.js"]},
      "fallback": "browser",
      "viewports": {
        "mobile": {"browserName": "chromium", "viewport": {"width": 390, "height": 844}, "deviceScaleFactor": 3, "isMobile": true, "hasTouch": true},
        "tablet": {"browserName": "chromium", "viewport": {"width": 820, "height": 1180}, "deviceScaleFactor": 2, "isMobile": true, "hasTouch": true},
        "desktop": {"browserName": "chromium", "viewport": {"width": 1440, "height": 900}}
      }
    },
    "browser": {"doc": "skills/verification/kip-receipts/providers/frontend.md", "via": "browser", "fallback": "generic"},
    "api": {"doc": "skills/verification/kip-receipts/providers/api.md", "fallback": "generic"},
    "generic": {"doc": "skills/verification/kip-receipts/providers/generic.md"}
  },
  "destinations": {
    "local": {"type": "local"},
    "linear": {"type": "linear", "requires": {"env": ["LINEAR_API_KEY"]}},
    "jira": {"type": "jira", "requires": {"env": ["JIRA_BASE_URL", "JIRA_EMAIL", "JIRA_API_TOKEN"]}},
    "github": {"type": "github", "requires": {"cmd": ["gh"]}},
    "github-issue": {"type": "github-issue", "requires": {"cmd": ["gh"]}}
  },
  "default_destination": "local",
  "workflow": {"stages": ["tidy", "review"], "checks": {}, "worktrees": "nudge", "loop": {"attempts": 3, "minutes": 10},
               "skills": {"decompose": "required", "implement": "required", "tidy": "required"}},
  "dashboard": {"conversation": true},
  "setup": {
    "playwright": {
      "about": "Playwright for desk tests (downloads about 150 MB)",
      "requires": {"file": ["~/.kip/node_modules/@playwright/test/cli.js"]},
      "run": "bash ~/.kip/skills/kip-receipts/playwright/setup.sh"
    }
  }
}
